[Unit]
Description=NKAMG FastAPI web backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/github/NKAMG-AIDefender/web/FastAPI
ExecStart=/home/ubuntu/github/NKAMG-AIDefender/web/FastAPI/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
